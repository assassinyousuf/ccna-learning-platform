# NextAuth Secret (Generate via: openssl rand -base64 32)
NEXTAUTH_SECRET=a8f4c2e1b9d073e5f68a2c4e6b8d0f1a3c5e7b9d1f3a5c7e9b1d3f5a7c9e1b3d
NEXTAUTH_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 1. Google OAuth 2.0 (For Student Sign-In)
# Obtain from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Authorized redirect URI: https://your-domain.vercel.app/api/auth/callback/google
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ------------------------------------------------------------------------------
# 2. Google Workspace Resource IDs (Connected)
# ------------------------------------------------------------------------------
# ID of the Google Drive Folder where student lab videos will be stored
GOOGLE_DRIVE_FOLDER_ID=1a2Z9Volf4japNJ7_OW3-ab0xfmjSnXhW

# ID of the Google Spreadsheet used as the student database
GOOGLE_SHEET_ID=1up3eYvs-wcIX3MS-aNjYYRHF3QFoOlpvTZb3h57E9s4

# ------------------------------------------------------------------------------
# 3. Google Service Account (For Automated Drive & Sheets API Access)
# Create a Service Account in Google Cloud Console with roles:
# - Google Drive API (access to your 5TB upload folder)
# - Google Sheets API (access to your student gradebook sheet)
# ------------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=ccna-platform-service@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"
